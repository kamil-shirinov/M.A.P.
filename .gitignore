# --- environment ---
.venv/
__pycache__/
*.py[cod]

# --- tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- build ---
dist/
build/
*.egg-info/

# --- M.A.P. artifacts ---
# Run outputs are reproducible from the manifest and are per-machine. The trace can
# also contain the text of whatever news was fed in, which may not be redistributable.
/runs/

# Derived local state: LLM response cache, parquet price cache, SEC symbol index.
# All of it is rebuildable and none of it belongs in version control.
#
# Neither directory is tracked, not even for a placeholder: every command that writes
# to one creates it, and every command that only reads one treats its absence as "nothing
# here yet". `tests/unit/test_fresh_clone.py` holds both to that.
/var/

# --- the built site ---
# ==> checking the tree is committed assembles a servable copy here. Derived from the export,
# which is itself derived; rebuilt by the script, never edited.
site/

# --- the front end's export ---
# `ui/` carries its own .gitignore with the same rule, so this is belt and braces —
# and it is the belt: the root file is where someone looks before wondering why a
# 5 MB directory keeps appearing in `git status`. Derived output of `map export`,
# rebuilt from the ledger and the runs, and never the source of anything.
ui/assets/export/

# Local news corpus — untrusted third-party text, not ours to commit.
# Anchored with a leading slash on purpose: a bare `news/` matches at ANY depth and
# would silently swallow tests/fixtures/news/, which DoD criterion 6 depends on.
/news/

# --- local overrides ---
# config/default.toml IS committed. Machine-specific values (the SEC User-Agent in
# particular) belong in an untracked override or in MAP_ environment variables.
config/local.toml
.env

# --- os ---
.DS_Store

# NOTE: uv.lock is deliberately NOT ignored. It is committed for reproducibility.

config/local.toml
graphify-out/

# Obsidian per-session UI state (open tabs, pane layout). The rest of .obsidian/
# is vault configuration and is tracked, so the graph view reproduces for anyone
# who opens it.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Claude Code settings: configures a machine, not the project.
.claude/settings.json

.obsidian/
